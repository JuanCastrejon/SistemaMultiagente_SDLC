{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/sistema-multiagente-sdlc/sdlc.config.schema.json",
  "title": "SistemaMultiagente_SDLC config",
  "type": "object",
  "required": [
    "schemaVersion",
    "frameworkVersion",
    "project",
    "mode",
    "surfaces",
    "gitFlow",
    "openspec"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "frameworkVersion": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "organization": {
          "type": "string",
          "pattern": "^[^\\r\\n]*$"
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "greenfield",
        "legacy"
      ]
    },
    "scale": {
      "type": "string",
      "enum": [
        "bug",
        "feature",
        "epic",
        "platform"
      ],
      "default": "feature",
      "description": "Scale hint used by v1.3.0+ for adaptive planning and agent routing."
    },
    "stack": {
      "type": "object",
      "properties": {
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tecnologia real de esta superficie, o null si el proyecto no la tiene. Nunca un placeholder tipo <BACKEND_STACK>: `doctor` los rechaza."
        },
        "frontend": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tecnologia real de esta superficie, o null si el proyecto no la tiene. Nunca un placeholder tipo <BACKEND_STACK>: `doctor` los rechaza."
        },
        "database": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tecnologia real de esta superficie, o null si el proyecto no la tiene. Nunca un placeholder tipo <BACKEND_STACK>: `doctor` los rechaza."
        },
        "designSystem": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tecnologia real de esta superficie, o null si el proyecto no la tiene. Nunca un placeholder tipo <BACKEND_STACK>: `doctor` los rechaza."
        },
        "mobile": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tecnologia real de esta superficie, o null si el proyecto no la tiene. Nunca un placeholder tipo <BACKEND_STACK>: `doctor` los rechaza."
        }
      }
    },
    "surfaces": {
      "type": "array",
      "description": "Fuente unica de las superficies del repo. quality-contract.yaml se genera desde esta lista en vez de traer superficies inventadas (ADR 0007, P6): sin esto, un repo cuyo layout no coincide con el ejemplo del template media gates sobre paths que no existen.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "tier": {
            "type": "string",
            "enum": [
              "core",
              "standard",
              "shell"
            ],
            "default": "standard",
            "description": "Dinero/maquina de estados/datos regulados = core. Producto sin impacto directo en dinero = standard. UI/scaffolding/herramientas internas = shell."
          },
          "moneyPath": {
            "type": "boolean",
            "default": false
          },
          "hasUi": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "gitFlow": {
      "type": "object",
      "required": [
        "integrationBranch",
        "stableBranch"
      ],
      "description": "Estos campos NO son texto libre: se interpolan sin escapar dentro de un asignacion de shell en quality-verify.yml (`BASE=\"origin/{{gitFlow.integrationBranch}}\"`) y en el `on.push.branches` del workflow. Prohibir solo CR/LF filtraba una carga util, no la causa: una comilla basta para salir de la asignacion. Se restringen al juego de caracteres real de un nombre de rama git, que ademas excluye todo metacaracter de shell.",
      "properties": {
        "integrationBranch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "stableBranch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "branchPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "description": "Modelo de amenaza para la firma humana verificable (ADR 0007, signed-attestation). Con un solo maintainer, GitHub prohibe auto-aprobar un PR propio: platform-review es insatisfacible, y la firma se verifica por commit firmado en vez de por review de plataforma.",
      "properties": {
        "threatModel": {
          "type": "string",
          "enum": [
            "single-maintainer",
            "team"
          ],
          "default": "single-maintainer"
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "signer"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^\\r\\n]*$"
              },
              "signer": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]*$",
                "description": "Identidad exacta que reporta `git log --format=%GS` para una firma valida de esta persona (nombre y correo de la clave GPG/SSH, no de git config)."
              }
            }
          }
        }
      }
    },
    "openspec": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "minimal",
            "expanded",
            "custom"
          ]
        },
        "customProfile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "name",
                "workflows"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]*$"
                },
                "workflows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*$"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "if": {
    "properties": {
      "openspec": {
        "type": "object",
        "properties": {
          "profile": {
            "const": "custom"
          }
        },
        "required": [
          "profile"
        ]
      }
    },
    "required": [
      "openspec"
    ]
  },
  "then": {
    "properties": {
      "openspec": {
        "type": "object",
        "required": [
          "customProfile"
        ],
        "properties": {
          "customProfile": {
            "type": "object",
            "required": [
              "name",
              "workflows"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "workflows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
