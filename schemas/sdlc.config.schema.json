{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/sistema-multiagente-sdlc/sdlc.config.schema.json",
  "title": "SistemaMultiagente_SDLC config",
  "type": "object",
  "required": ["schemaVersion", "frameworkVersion", "project", "mode", "surfaces", "gitFlow", "openspec"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "frameworkVersion": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "organization": { "type": "string" }
      }
    },
    "mode": { "type": "string", "enum": ["greenfield", "legacy"] },
    "scale": {
      "type": "string",
      "enum": ["bug", "feature", "epic", "platform"],
      "default": "feature",
      "description": "Scale hint used by v1.3.0+ for adaptive planning and agent routing."
    },
    "stack": {
      "type": "object",
      "properties": {
        "backend": { "type": "string" },
        "frontend": { "type": "string" },
        "database": { "type": "string" },
        "designSystem": { "type": "string" },
        "mobile": { "type": "string" }
      }
    },
    "surfaces": {
      "type": "array",
      "description": "Fuente unica de las superficies del repo. quality-contract.yaml se genera desde esta lista en vez de traer superficies inventadas (ADR 0007, P6): sin esto, un repo cuyo layout no coincide con el ejemplo del template media gates sobre paths que no existen.",
      "items": {
        "type": "object",
        "required": ["id", "path", "owner"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "owner": { "type": "string" },
          "tier": {
            "type": "string",
            "enum": ["core", "standard", "shell"],
            "default": "standard",
            "description": "Dinero/maquina de estados/datos regulados = core. Producto sin impacto directo en dinero = standard. UI/scaffolding/herramientas internas = shell."
          },
          "moneyPath": { "type": "boolean", "default": false },
          "hasUi": { "type": "boolean", "default": false }
        }
      }
    },
    "gitFlow": {
      "type": "object",
      "required": ["integrationBranch", "stableBranch"],
      "properties": {
        "integrationBranch": { "type": "string" },
        "stableBranch": { "type": "string" },
        "branchPrefixes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance": {
      "type": "object",
      "description": "Modelo de amenaza para la firma humana verificable (ADR 0007, signed-attestation). Con un solo maintainer, GitHub prohibe auto-aprobar un PR propio: platform-review es insatisfacible, y la firma se verifica por commit firmado en vez de por review de plataforma.",
      "properties": {
        "threatModel": {
          "type": "string",
          "enum": ["single-maintainer", "team"],
          "default": "single-maintainer"
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["signer"],
            "properties": {
              "name": { "type": "string" },
              "signer": {
                "type": "string",
                "minLength": 1,
                "description": "Identidad exacta que reporta `git log --format=%GS` para una firma valida de esta persona (nombre y correo de la clave GPG/SSH, no de git config)."
              }
            }
          }
        }
      }
    },
    "openspec": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "enum": ["minimal", "expanded", "custom"] },
        "customProfile": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "workflows"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "workflows": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          ]
        }
      }
    }
  },
  "if": {
    "properties": {
      "openspec": {
        "type": "object",
        "properties": { "profile": { "const": "custom" } },
        "required": ["profile"]
      }
    },
    "required": ["openspec"]
  },
  "then": {
    "properties": {
      "openspec": {
        "type": "object",
        "required": ["customProfile"],
        "properties": {
          "customProfile": {
            "type": "object",
            "required": ["name", "workflows"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "workflows": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
